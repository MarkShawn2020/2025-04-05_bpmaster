/* pages/index/index.wxss */

/* Banner样式 */
.banner-swiper {
  width: 100%;
  height: 360rpx;
  margin-bottom: 30rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.banner-title {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent);
  color: #fff;
  padding: 20rpx;
  font-size: 28rpx;
  font-weight: 500;
  border-bottom-left-radius: 12rpx;
  border-bottom-right-radius: 12rpx;
}

/* 统计卡片样式 */
.stats-container {
  margin-bottom: 30rpx;
  padding: 0 16rpx;
}

/* 高亮统计卡片样式 */
.stats-highlight-card {
  background: linear-gradient(135deg, #3563e9, #0f41ab);
  border-radius: 12rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(53, 99, 233, 0.2);
}

.stats-highlight-content {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  text-align: center;
}

.stats-highlight-text {
  color: rgba(255, 255, 255, 0.9);
  font-size: 32rpx;
  margin: 0 10rpx;
}

.stats-highlight-value {
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 700;
  margin: 0 10rpx;
}

/* 添加分隔线样式 */
.stats-divider {
  height: 1px;
  background-color: #f0f0f0;
  margin: 10rpx 5% 20rpx;
  width: 90%;
}

.stats-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx; /* 增加行间距 */
}

.stats-card {
  width: 48%;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
  border: 1px solid #f0f0f0; /* 添加边框 */
}

.stats-card.highlight {
  background-color: var(--primary-light);
  border: 1px solid var(--primary-color);
}

.stats-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stats-value {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.stats-card.highlight .stats-value {
  color: var(--primary-color);
}

.stats-badge {
  background-color: var(--primary-color);
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 30rpx;
}

.stats-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.stats-subtitle {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 12rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 行业分布图表 */
.industry-card {
  width: 100% !important;
}

.industry-chart {
  margin-top: 16rpx;
}

.industry-bar {
  display: flex;
  height: 24rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.industry-segment {
  height: 100%;
}

.industry-segment.tech {
  background-color: #3563e9;
}

.industry-segment.finance {
  background-color: #2dca8c;
}

.industry-segment.healthcare {
  background-color: #ffb800;
}

.industry-segment.education {
  background-color: #f76808;
}

.industry-segment.other {
  background-color: #c4c9d2;
}

.industry-legend {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.legend-item {
  display: flex;
  align-items: center;
  margin-right: 16rpx;
  margin-bottom: 8rpx;
}

.legend-color {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
  margin-right: 8rpx;
}

.legend-color.tech {
  background-color: #3563e9;
}

.legend-color.finance {
  background-color: #2dca8c;
}

.legend-color.healthcare {
  background-color: #ffb800;
}

.legend-color.education {
  background-color: #f76808;
}

.legend-color.other {
  background-color: #c4c9d2;
}

.legend-text {
  font-size: 20rpx;
  color: var(--text-secondary);
}

/* 功能区样式 - 优化双列布局 */
.feature-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx 30rpx;
  box-sizing: border-box;
  width: 100%;
}

.feature-item {
  width: 50%;
  box-sizing: border-box;
  padding: 8rpx;
}

.feature-item-inner {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}

.feature-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
}

/* 新增SVG图标容器样式 */
.feature-icon-container {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* SVG样式 */
.feature-icon-container svg {
  width: 100%;
  height: 100%;
}

.feature-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 10rpx;
}

.feature-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  text-align: center;
}

/* 最近分析区域 */
.recent-section {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.section-more {
  font-size: 24rpx;
  color: var(--primary-color);
}

/* 双列卡片布局 */
.analysis-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx;
}

.analysis-card {
  width: calc(50% - 20rpx);
  margin: 10rpx;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  border: 1px solid var(--border-color);
  box-sizing: border-box;
  transition: all 0.3s ease;
}

.analysis-card:active {
  transform: scale(0.98);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.1);
}

.analysis-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.file-icon {
  width: 48rpx;
  height: 48rpx;
}

.analysis-card-score {
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 8rpx;
  padding: 6rpx 16rpx;
}

.analysis-card-title {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.analysis-card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.analysis-card-time {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.analysis-card-tag {
  font-size: 22rpx;
  color: var(--primary-color);
  background-color: var(--primary-light);
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}

/* 分数样式 */
.score-excellent {
  color: var(--success-color);
  background-color: rgba(45, 202, 140, 0.1);
}

.score-good {
  color: var(--primary-color);
  background-color: var(--primary-light);
}

.score-average {
  color: var(--warning-color);
  background-color: rgba(255, 184, 0, 0.1);
}

/* 原列表样式 - 保留做参考 */
.analysis-list {
  margin-top: 20rpx;
}

.analysis-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1px solid var(--border-color);
}

.analysis-item:last-child {
  border-bottom: none;
}

.analysis-content {
  flex: 1;
}

.analysis-title {
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 420rpx;
}

.analysis-time {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.analysis-score {
  font-size: 36rpx;
  font-weight: 600;
  border-radius: 8rpx;
  padding: 10rpx 20rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}
/* 
.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
} */

.empty-text {
  font-size: 28rpx;
  color: var(--text-tertiary);
  margin-bottom: 30rpx;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(53, 99, 233, 0.2);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* 登录面板 */
.login-panel-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.login-panel {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  z-index: 1001;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.login-panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1px solid var(--border-color);
}

.login-panel-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.login-panel-close {
  font-size: 40rpx;
  color: var(--text-tertiary);
  line-height: 1;
}

.login-panel-content {
  padding: 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-logo {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 30rpx;
}

.login-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 40rpx;
  text-align: center;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #07c160;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 8rpx;
  display: flex;
  justify-content: center;
  align-items: center;
} 