/* pages/index/index.wxss */

/* Banner样式 */
.banner-swiper {
  width: 100%;
  height: 360rpx;
  margin-bottom: 30rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.banner-title {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent);
  color: #fff;
  padding: 20rpx;
  font-size: 28rpx;
  font-weight: 500;
  border-bottom-left-radius: 12rpx;
  border-bottom-right-radius: 12rpx;
}

/* 功能区样式 */
.feature-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx 30rpx;
}

.feature-item {
  width: calc(50% - 20rpx);
  background-color: #fff;
  border-radius: 12rpx;
  margin: 10rpx;
  padding: 30rpx 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.feature-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
}

.feature-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 10rpx;
}

.feature-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  text-align: center;
}

/* 最近分析区域 */
.recent-section {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.section-more {
  font-size: 24rpx;
  color: var(--primary-color);
}

.analysis-list {
  margin-top: 20rpx;
}

.analysis-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1px solid var(--border-color);
}

.analysis-item:last-child {
  border-bottom: none;
}

.analysis-content {
  flex: 1;
}

.analysis-title {
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 420rpx;
}

.analysis-time {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.analysis-score {
  font-size: 36rpx;
  font-weight: 600;
  border-radius: 8rpx;
  padding: 10rpx 20rpx;
}

.score-excellent {
  color: var(--success-color);
  background-color: rgba(45, 202, 140, 0.1);
}

.score-good {
  color: var(--primary-color);
  background-color: var(--primary-light);
}

.score-average {
  color: var(--warning-color);
  background-color: rgba(255, 184, 0, 0.1);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-tertiary);
  margin-bottom: 30rpx;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(53, 99, 233, 0.2);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* 登录面板 */
.login-panel-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.login-panel {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  z-index: 1001;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.login-panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1px solid var(--border-color);
}

.login-panel-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.login-panel-close {
  font-size: 40rpx;
  color: var(--text-tertiary);
  line-height: 1;
}

.login-panel-content {
  padding: 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-logo {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 30rpx;
}

.login-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 40rpx;
  text-align: center;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #07c160;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 8rpx;
} 