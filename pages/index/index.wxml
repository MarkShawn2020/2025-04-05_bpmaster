<view class="container">
  <!-- 顶部Banner轮播 -->
  <swiper class="banner-swiper" indicator-dots="{{true}}" autoplay="{{true}}" interval="{{3000}}" duration="{{500}}" circular="{{true}}">
    <block wx:for="{{bannerList}}" wx:key="id">
      <swiper-item bindtap="onBannerTap" data-index="{{index}}">
        <image src="{{item.imageUrl}}" class="banner-image" mode="aspectFill"></image>
        <view class="banner-title">{{item.title}}</view>
      </swiper-item>
    </block>
  </swiper>

  <!-- 数据统计区域 - 优化版 -->
  <view class="stats-container">
    <!-- 主要统计数据卡片 -->
    <view class="stats-main-card">
      <view class="stats-title">平台概览</view>
      
      <view class="stats-metrics-row">
        <view class="stats-metric">
          <view class="metric-value">{{statistics.totalUsers || 0}}</view>
          <view class="metric-label">累计用户</view>
        </view>
        
        <view class="stats-metric">
          <view class="metric-value">{{statistics.fileCount || 0}}</view>
          <view class="metric-label">上传文件</view>
        </view>
        
        <view class="stats-metric">
          <view class="metric-value">{{statistics.totalAnalysis || 0}}</view>
          <view class="metric-label">分析总数</view>
        </view>
      </view>
      
      <!-- 活跃度指标 -->
      <view class="stats-growth-section">
        <view class="growth-header">
          <view class="growth-title">近7天分析活跃度</view>
          <view class="growth-badge" wx:if="{{statistics.weeklyAnalysis > 0}}">↑ {{statistics.weeklyAnalysis}}</view>
        </view>
        
        <view class="activity-bars">
          <view class="activity-bar" wx:for="{{statistics.dailyActivity || [0,0,0,0,0,0,0]}}" wx:key="index" style="height: {{item > 0 ? (item/statistics.maxDailyActivity)*120 : 10}}rpx;"></view>
        </view>
        <view class="activity-labels">
          <view class="day-label" wx:for="{{['一','二','三','四','五','六','日']}}" wx:key="index">{{item}}</view>
        </view>
      </view>
    </view>
    
    <!-- 行业统计卡片 -->
    <view class="stats-row">
      <view class="stats-card industry-card">
        <view class="stats-header">
          <view class="stats-label">BP行业分布</view>
        </view>
        <view class="industry-chart">
          <view class="industry-bar">
            <view class="industry-segment tech" style="width: {{statistics.industryDistribution.tech}}%;"></view>
            <view class="industry-segment finance" style="width: {{statistics.industryDistribution.finance}}%;"></view>
            <view class="industry-segment healthcare" style="width: {{statistics.industryDistribution.healthcare}}%;"></view>
            <view class="industry-segment education" style="width: {{statistics.industryDistribution.education}}%;"></view>
            <view class="industry-segment other" style="width: {{statistics.industryDistribution.other}}%;"></view>
          </view>
          <view class="industry-legend">
            <view class="legend-item">
              <view class="legend-color tech"></view>
              <view class="legend-text">科技 {{statistics.industryDistribution.tech}}%</view>
            </view>
            <view class="legend-item">
              <view class="legend-color finance"></view>
              <view class="legend-text">金融 {{statistics.industryDistribution.finance}}%</view>
            </view>
            <view class="legend-item">
              <view class="legend-color healthcare"></view>
              <view class="legend-text">医疗 {{statistics.industryDistribution.healthcare}}%</view>
            </view>
            <view class="legend-item">
              <view class="legend-color education"></view>
              <view class="legend-text">教育 {{statistics.industryDistribution.education}}%</view>
            </view>
            <view class="legend-item">
              <view class="legend-color other"></view>
              <view class="legend-text">其他 {{statistics.industryDistribution.other}}%</view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 功能区 - 使用优化后的双列布局 -->
  <view class="feature-grid">
    <view class="feature-item" wx:for="{{featureList}}" wx:key="id" bindtap="onFeatureTap" data-id="{{item.id}}">
      <view class="feature-item-inner">
        <image src="{{item.icon}}" class="feature-icon" mode="aspectFit"></image>
        <view class="feature-title">{{item.title}}</view>
        <view class="feature-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>


    <view class="empty-state" >

  <button class="btn-primary" bindtap="goToUpload">立即上传分析</button>
    </view>

  <!-- 用户登录面板 -->
  <view class="login-panel-mask" wx:if="{{showLoginPanel}}" bindtap="hideLoginPanel"></view>
  <view class="login-panel" wx:if="{{showLoginPanel}}">
    <view class="login-panel-header">
      <view class="login-panel-title">用户登录</view>
      <view class="login-panel-close" bindtap="hideLoginPanel">×</view>
    </view>
    <view class="login-panel-content">
      <image src="/assets/images/logo.jpeg" class="login-logo" mode="aspectFit"></image>
      <view class="login-desc">登录后体验BP小诸葛的全部功能</view>
      <button class="login-btn" bindtap="handleLogin" loading="{{loginLoading}}">微信快捷登录</button>
    </view>
  </view>

  <!-- Toast组件 -->
  <mp-toast id="toast"></mp-toast>
</view> 