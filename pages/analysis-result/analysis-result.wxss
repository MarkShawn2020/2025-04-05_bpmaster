/* pages/analysis-result/analysis-result.wxss */

.container {
  padding: 30rpx;
  background-color: #f7f8fa;
  min-height: 100vh;
}

.analysis-card {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.file-info {
  display: flex;
  align-items: center;
  padding-bottom: 30rpx;
  border-bottom: 1px solid var(--border-color);
  margin-bottom: 30rpx;
}

.file-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 20rpx;
}

.file-detail {
  flex: 1;
}

.file-name {
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  word-break: break-all;
}

.file-meta {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.analysis-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.analysis-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.analysis-status {
  display: flex;
  align-items: center;
}

.status-text {
  font-size: 24rpx;
  margin-right: 10rpx;
}

.status-loading {
  color: var(--primary-color);
}

.status-success {
  color: var(--success-color);
}

.status-icon {
  width: 32rpx;
  height: 32rpx;
}

.loading-container {
  margin: 30rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-animation {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 20rpx;
}

.loading-tips {
  font-size: 24rpx;
  color: var(--text-tertiary);
  text-align: center;
  max-width: 600rpx;
}

.markdown-container {
  padding: 0 10rpx;
}

/* 自定义wemark样式 */
.wemark-container {
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--text-primary);
}

.wemark-container .h1 {
  font-size: 38rpx;
  font-weight: 600;
  margin: 30rpx 0 20rpx;
  padding-bottom: 14rpx;
  border-bottom: 1px solid var(--border-color);
}

.wemark-container .h2 {
  font-size: 34rpx;
  font-weight: 600;
  margin: 28rpx 0 18rpx;
}

.wemark-container .h3 {
  font-size: 32rpx;
  font-weight: 600;
  margin: 26rpx 0 16rpx;
}

.wemark-container .h4,
.wemark-container .h5,
.wemark-container .h6 {
  font-size: 30rpx;
  font-weight: 600;
  margin: 24rpx 0 14rpx;
}

.wemark-container .p {
  margin: 20rpx 0;
}

.wemark-container .strong {
  font-weight: 600;
  color: var(--text-primary);
}

.wemark-container .code {
  font-family: Menlo, Monaco, 'Courier New', monospace;
  background-color: #f5f7fa;
  border-radius: 4rpx;
  padding: 4rpx 8rpx;
  margin: 0 4rpx;
  font-size: 26rpx;
}

.wemark-container .table {
  margin: 20rpx 0;
  border-collapse: collapse;
}

.wemark-container .tr {
  display: flex;
}

.wemark-container .th,
.wemark-container .td {
  padding: 16rpx;
  border: 1px solid var(--border-color);
  flex: 1;
}

.wemark-container .th {
  background-color: #f5f7fa;
  font-weight: 600;
}

.wemark-container .blockquote {
  padding: 16rpx 20rpx;
  border-left: 6rpx solid var(--primary-light);
  background-color: #f5f7fa;
  color: var(--text-secondary);
  margin: 20rpx 0;
}

.wemark-container .ul,
.wemark-container .ol {
  padding-left: 40rpx;
  margin: 20rpx 0;
}

.wemark-container .li {
  margin: 12rpx 0;
}

/* 动画相关 */
@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.fade-in {
  animation: fadeIn 0.5s ease-in-out;
}

/* 操作按钮区域 */
.action-bar {
  display: flex;
  justify-content: space-between;
  margin-top: 40rpx;
  padding-top: 30rpx;
  border-top: 1px solid var(--border-color);
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  margin: 0 10rpx;
}

.btn-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
}

.toc-container {
  margin-bottom: 30rpx;
  padding: 20rpx;
  background-color: #f5f7fa;
  border-radius: 8rpx;
}

.toc-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.toc-item {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin: 12rpx 0;
  padding-left: 20rpx;
  position: relative;
}

.toc-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 12rpx;
  width: 8rpx;
  height: 8rpx;
  background-color: var(--primary-color);
  border-radius: 50%;
}

.error-container {
  padding: 30rpx;
  background-color: #fff6f6;
  border-radius: 8rpx;
  border-left: 6rpx solid var(--danger-color);
  margin-bottom: 30rpx;
}

.error-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--danger-color);
  margin-bottom: 16rpx;
}

.error-message {
  font-size: 26rpx;
  color: var(--text-primary);
  margin-bottom: 24rpx;
  word-break: break-all;
}

.error-action {
  margin-top: 20rpx;
} 