<!--pages/analysis-result/analysis-result.wxml-->
<view class="container">
  <!-- 文件信息卡片 -->
  <view class="analysis-card">
    <view class="file-info" bindtap="handleOpenFile" hover-class="hover">
      <image class="file-icon" src="{{fileType ? '/images/file-icons/file-' + fileType + '.png' : '/images/file-icons/file-unknown.png'}}"></image>
      <view class="file-detail">
        <view class="file-name">{{fileName || '未知文件'}}</view>
        <view class="file-meta">
          <text class="file-size">{{fileSize || '未知大小'}}</text>
          <text class="meta-separator" wx:if="{{fileSize && fileTime}}">·</text>
          <text class="file-time">{{fileTime || ''}}</text>
        </view>
      </view>
    </view>
    
    <!-- 分析状态头部 -->
    <view class="analysis-header">
      <view class="analysis-title">AI评估报告</view>
      <view class="analysis-status">
        <text class="status-text {{isAnalyzing ? 'status-loading' : (isCompleted ? 'status-success' : '')}}">{{statusText}}</text>
        <image wx:if="{{isAnalyzing && isImageExists}}" class="status-icon" src="/images/loading-icon.png"></image>
        <image wx:if="{{isCompleted}}" class="status-icon" src="/images/check-circle.png"></image>
      </view>
    </view>
    
    <!-- 分析中状态 -->
    <block wx:if="{{isAnalyzing && !mdContent}}">
      <view class="loading-container">
        <view class="loading-text">{{loadingTip}}</view>
        <view class="loading-tips">分析过程需要一些时间，请耐心等待</view>
        <button class="retry-btn" type="default" size="mini" bindtap="handleReAnalyze">
          重新分析
        </button>
      </view>
    </block>
    
    <!-- 分析中但有部分内容 -->
    <block wx:if="{{isAnalyzing && mdContent}}">
      <view class="loading-status">
        <view class="loading-text">{{loadingTip}}</view>
        <button class="retry-btn" type="default" size="mini" bindtap="handleReAnalyze">
          重新分析
        </button>
      </view>
    </block>
    
    <!-- 错误状态 -->
    <block wx:if="{{hasError}}">
      <view class="error-container">
        <view class="error-title">分析遇到问题</view>
        <view class="error-message">{{errorMessage || '未知错误，请稍后重试'}}</view>
        <view class="error-action">
          <button type="primary" bindtap="handleReAnalyze">重新分析</button>
        </view>
      </view>
    </block>
    
    <!-- 目录 (有内容且不为空时显示) -->
    <block wx:if="{{mdContent && tocItems.length > 0}}">
      <view class="toc-container">
        <view class="toc-title">报告目录</view>
        <view wx:for="{{tocItems}}" wx:key="index" class="toc-item" style="padding-left: {{(item.level - 1) * 40 + 20}}rpx;">
          {{item.title}}
        </view>
      </view>
    </block>
    
    <!-- Markdown内容 -->
    <block wx:if="{{mdContent}}">
      <view class="markdown-container {{isCompleted ? 'fade-in' : ''}}">
        <markdown content="{{mdContent}}"></markdown>
      </view>
      
      <!-- 操作按钮 (分析完成后显示) -->
      <block wx:if="{{isCompleted}}">
        <view class="action-bar">
          <view class="action-btn" hover-class="hover" bindtap="handleReAnalyze">
            <image class="btn-icon" src="/images/refresh.png"></image>
            <text class="btn-text">重新分析</text>
          </view>
          <view class="action-btn primary" hover-class="hover" bindtap="handleSaveReport">
            <image class="btn-icon" src="/images/save.png"></image>
            <text class="btn-text">保存报告</text>
          </view>
          <view class="action-btn" hover-class="hover" bindtap="handleShareReport">
            <image class="btn-icon" src="/images/share.png"></image>
            <text class="btn-text">分享</text>
          </view>
        </view>
      </block>
    </block>
  </view>
  
  <!-- toast组件 -->
  <toast id="toast"></toast>
</view> 