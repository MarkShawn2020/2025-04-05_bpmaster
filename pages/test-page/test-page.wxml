<!-- pages/test-page/test-page.wxml -->
<view class="container">
  <view class="header">
    <view class="title">测试页面 - 类型 {{pageType}}</view>
    <view class="subtitle">此页面用于测试独立运行的能力</view>
  </view>

  <view class="timer-card">
    <view class="timer-label">页面已打开时间</view>
    <view class="timer-value">{{formattedTime}}</view>
    <view class="timer-desc">{{elapsedTime}} 秒</view>
  </view>

  <view class="info-card">
    <view class="info-title">页面信息</view>
    <view class="info-row">
      <text class="info-label">页面类型:</text>
      <text class="info-value">{{pageType}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">开始时间:</text>
      <text class="info-value">{{startTime}}</text>
    </view>
    <view class="info-desc">
      如果能看到计时器在不断更新，说明页面处于活动状态，没有被销毁
    </view>
  </view>

  <view class="action-bar">
    <button class="action-button" bindtap="handleOpenOtherPage">
      打开页面 {{pageType === 'A' ? 'B' : 'A'}}
    </button>
    <button class="action-button home-button" bindtap="handleBackToHome">
      返回首页
    </button>
  </view>
</view>
