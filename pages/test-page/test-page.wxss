/* pages/test-page/test-page.wxss */
.container {
  padding: 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background-color: #f8f8f8;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
  padding: 20rpx 0;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #888;
}

.timer-card {
  background-color: #fff;
  padding: 40rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 30rpx;
  text-align: center;
}

.timer-label {
  font-size: 28rpx;
  color: #888;
  margin-bottom: 20rpx;
}

.timer-value {
  font-size: 80rpx;
  font-weight: bold;
  color: #007AFF;
  font-family: monospace;
  margin-bottom: 10rpx;
}

.timer-desc {
  font-size: 24rpx;
  color: #999;
}

.info-card {
  background-color: #fff;
  padding: 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 30rpx;
}

.info-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
  padding-bottom: 10rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.info-label {
  font-size: 28rpx;
  color: #666;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.info-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 20rpx;
  padding: 10rpx;
  background-color: #f0f9ff;
  border-radius: 8rpx;
}

.action-bar {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  margin-top: auto;
}

.action-button {
  flex: 1;
  margin: 0 10rpx;
  font-size: 28rpx;
  background-color: #007AFF;
  color: #fff;
}

.home-button {
  background-color: #ff9500;
}
