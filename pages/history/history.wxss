.history-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f8f8f8;
}

/* 顶部标题栏 */
.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background-color: #ffffff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  position: sticky;
  top: 0;
  z-index: 10;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
}

.header-action {
  display: flex;
  align-items: center;
}

.action-btn {
  font-size: 28rpx;
  color: #3366ff;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
}

/* 选择模式工具栏 */
.select-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.toolbar-item {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333333;
}

.toolbar-item.active {
  color: #3366ff;
}

.select-count {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #999999;
}

.delete-btn {
  color: #ff3333;
}

.delete-btn.disabled {
  color: #cccccc;
}

/* 分析列表 */
.analysis-list {
  flex: 1;
  padding: 0 24rpx;
  overflow-y: auto;
}

.analysis-item {
  display: flex;
  padding: 30rpx 24rpx;
  background-color: #ffffff;
  border-radius: 12rpx;
  margin-top: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
  position: relative;
}

.analysis-item.selecting {
  padding-left: 70rpx;
}

/* 复选框 */
.checkbox {
  position: absolute;
  left: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #dddddd;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkbox.checked {
  background-color: #3366ff;
  border-color: #3366ff;
}

.checkbox .inner {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background-color: #ffffff;
  display: none;
}

.checkbox.checked .inner {
  display: block;
}

/* 文件信息 */
.item-content {
  flex: 1;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.file-info {
  flex: 1;
  overflow: hidden;
}

.file-name {
  font-size: 32rpx;
  color: #333333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.file-meta {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999999;
}

.file-size {
  margin-right: 8rpx;
}

.dot {
  margin: 0 8rpx;
}

/* 分数容器 */
.score-container {
  display: flex;
  align-items: center;
  margin-left: 24rpx;
}

.score {
  font-size: 36rpx;
  font-weight: 600;
  color: #ff9900;
}

/* 状态标签 */
.status-tag {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.status-tag.processing {
  background-color: #e6f7ff;
  color: #1890ff;
}

.status-tag.failed {
  background-color: #fff1f0;
  color: #ff4d4f;
}

.status-tag.not-analyzed {
  background-color: #f5f5f5;
  color: #999999;
}

/* 删除图标 */
.delete-icon {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
}

.icon-inner {
  width: 30rpx;
  height: 30rpx;
  position: relative;
}

.line {
  position: absolute;
  width: 30rpx;
  height: 2rpx;
  background-color: #cccccc;
  top: 50%;
  left: 0;
}

.line1 {
  transform: rotate(45deg);
}

.line2 {
  transform: rotate(-45deg);
}

/* 加载更多 */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0;
}

.load-more.loading {
  justify-content: center;
}

.loading-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  border: 2rpx solid #dddddd;
  border-radius: 50%;
  border-top-color: #3366ff;
  animation: rotating 1s linear infinite;
}

@keyframes rotating {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.load-more-text {
  font-size: 26rpx;
  color: #999999;
}

/* 空状态 */
.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  background-color: #f5f5f5;
  border-radius: 50%;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
  margin-bottom: 30rpx;
}

.empty-action {
  padding: 16rpx 60rpx;
  background-color: #3366ff;
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 40rpx;
}

/* 加载状态 */
.loading-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-icon {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f5f5f5;
  border-top-color: #3366ff;
  border-radius: 50%;
  animation: rotating 1s linear infinite;
  margin-bottom: 30rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #999999;
} 