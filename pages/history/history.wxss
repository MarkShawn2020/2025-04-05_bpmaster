/* pages/history/history.wxss */

.history-container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding-bottom: 30rpx;
}

/* 头部标题栏样式 */
.history-header {
  padding: 30rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #fff;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.header-action {
  font-size: 28rpx;
  color: #3563E9;
}

.action-btn {
  padding: 10rpx 20rpx;
}

/* 选择工具栏样式 */
.select-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
}

.toolbar-item {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
  padding: 10rpx 0;
}

.toolbar-item.active {
  color: #3563E9;
}

.toolbar-item.delete-btn {
  color: #FF4D4F;
}

.toolbar-item.disabled {
  color: #c0c0c0;
}

.select-count {
  margin-left: 10rpx;
  font-size: 24rpx;
  color: #999;
}

/* 分析列表样式 */
.analysis-list {
  padding: 20rpx 30rpx;
  height: calc(100vh - 180rpx);
}

/* 分析项目样式 */
.analysis-item {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  position: relative;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.analysis-item.selecting {
  padding-left: 80rpx;
}

/* 选中项的样式 - 重要：确保有明显的视觉反馈 */
.analysis-item.item-selected {
  background-color: #f0f7ff;
  border: 1rpx solid #3563E9;
}

/* 选择框样式 */
.checkbox {
  position: absolute;
  left: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #c0c0c0;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
  background-color: #fff;
  transition: all 0.3s ease;
}

.checkbox.checked {
  background-color: #3563E9;
  border-color: #3563E9;
}

.checkbox .inner {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background-color: #fff;
  opacity: 0;
  transition: opacity 0.2s ease;
}

.checkbox.checked .inner {
  opacity: 1;
}

/* 文件信息样式 */
.item-content {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.file-info {
  flex: 1;
  margin-right: 20rpx;
}

.file-name {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 10rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 400rpx;
}

.file-meta {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.file-size {
  margin-right: 10rpx;
}

.dot {
  margin: 0 6rpx;
}

/* 评分样式 */
.score-container {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-width: 100rpx;
}

.score {
  font-size: 38rpx;
  font-weight: bold;
  color: #3563E9;
}

/* 状态标签样式 */
.status-tag {
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  font-size: 24rpx;
  text-align: center;
}

.status-tag.processing {
  background-color: #e6f7ff;
  color: #1890ff;
}

.status-tag.failed {
  background-color: #fff2f0;
  color: #ff4d4f;
}

.status-tag.not-analyzed {
  background-color: #f5f5f5;
  color: #999;
}

/* 操作按钮样式 */
.action-buttons {
  display: flex;
  align-items: center;
}

.preview-icon, .delete-icon {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-left: 10rpx;
}

.icon-inner {
  width: 36rpx;
  height: 36rpx;
  position: relative;
}

.icon-inner.preview {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.p-line {
  height: 2rpx;
  background-color: #666;
  margin: 4rpx 0;
}

.p-line1 {
  width: 100%;
}

.p-line2 {
  width: 70%;
}

.p-line3 {
  width: 40%;
}

.delete-icon .line {
  position: absolute;
  width: 100%;
  height: 2rpx;
  background-color: #FF4D4F;
  top: 50%;
  left: 0;
}

.delete-icon .line1 {
  transform: rotate(45deg);
}

.delete-icon .line2 {
  transform: rotate(-45deg);
}

/* 加载更多样式 */
.load-more {
  text-align: center;
  padding: 30rpx 0;
}

.load-more.loading {
  display: flex;
  justify-content: center;
  align-items: center;
}

.loading-icon {
  width: 30rpx;
  height: 30rpx;
  border: 2rpx solid #3563E9;
  border-radius: 50%;
  border-bottom-color: transparent;
  animation: loading 1s linear infinite;
  margin-right: 10rpx;
}

@keyframes loading {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.load-more-text {
  font-size: 26rpx;
  color: #999;
}

/* 空状态样式 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  background-color: #f5f5f5;
  border-radius: 50%;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.empty-action {
  padding: 16rpx 30rpx;
  background-color: #3563E9;
  color: #fff;
  font-size: 28rpx;
  border-radius: 6rpx;
}

/* 首次加载中样式 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-state .loading-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 20rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
} 