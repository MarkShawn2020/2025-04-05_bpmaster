 <!--pages/history/history.wxml-->
<view class="history-container">
  <!-- 顶部标题栏 -->
  <view class="history-header">
    <view class="header-title">分析记录</view>
    <view class="header-action" wx:if="{{!isSelecting && analysisList.length > 0}}" bindtap="enableSelectMode">
      <view class="action-btn">管理</view>
    </view>
    <view class="header-action" wx:if="{{isSelecting}}" bindtap="cancelSelectMode">
      <view class="action-btn">取消</view>
    </view>
  </view>
  
  <!-- 选择模式工具栏 -->
  <view class="select-toolbar" wx:if="{{isSelecting}}">
    <view class="toolbar-item {{selectedItems.length === analysisList.length ? 'active' : ''}}" bindtap="toggleSelectAll">
      <text>全选</text>
      <text class="select-count" wx:if="{{selectedItems.length > 0}}">已选 {{selectedItems.length}}/{{analysisList.length}}</text>
    </view>
    <view class="toolbar-item delete-btn {{selectedItems.length === 0 ? 'disabled' : ''}}" bindtap="deleteSelected">
      <text>删除</text>
    </view>
  </view>
  
  <!-- 记录列表 -->
  <scroll-view class="analysis-list" scroll-y="true" lower-threshold="50" bindscrolltolower="loadMore" enable-back-to-top="true" wx:if="{{analysisList.length > 0}}">
    <view class="analysis-item {{isSelecting ? 'selecting' : ''}} {{item.isSelected ? 'item-selected' : ''}}" wx:for="{{analysisList}}" wx:key="id" data-id="{{item.id}}" bindtap="viewAnalysisDetail">
      <!-- 选择框 -->
      <view class="checkbox {{item.isSelected || selectedItems.includes(item.id) ? 'checked' : ''}}" 
        wx:if="{{isSelecting}}" 
        catch:tap="toggleSelectItem" 
        data-id="{{item.id}}"
        style="width: 48rpx; height: 48rpx; border-width: 2rpx;">
        <view class="inner" style="opacity: {{item.isSelected || selectedItems.includes(item.id) ? 1 : 0}};"></view>
      </view>
      
      <!-- 文件信息 -->
      <view class="item-content">
        <view class="file-info">
          <view class="file-name">{{item.fileName}}</view>
          <view class="file-meta">
            <text class="file-size">{{item.fileSize}}</text>
            <text class="dot">·</text>
            <text class="analysis-time">{{item.analysisDate}}</text>
          </view>
        </view>
        
        <!-- 评分展示 -->
        <view class="score-container">
          <!-- 只有当状态为已完成时才显示分数 -->
          <block wx:if="{{item.status === 'COMPLETED'}}">
            <view class="score">{{item.score || 0}}分</view>
          </block>
          <!-- 如果状态为处理中，显示处理中的标识 -->
          <block wx:elif="{{item.status === 'PROCESSING'}}">
            <view class="status-tag processing">处理中</view>
          </block>
          <!-- 如果状态为失败，显示失败标识 -->
          <block wx:elif="{{item.status === 'FAILED'}}">
            <view class="status-tag failed">分析失败</view>
          </block>
          <!-- 如果状态为尚未分析，显示未分析标识 -->
          <block wx:elif="{{item.status === 'NOT_ANALYZED'}}">
            <view class="status-tag not-analyzed">未分析</view>
          </block>
        </view>
        
        <!-- 操作按钮 -->
        <view class="action-buttons" wx:if="{{!isSelecting}}">
          <!-- 预览按钮 -->
          <view class="preview-icon" catchtap="previewFile" data-id="{{item.id}}">
            <view class="icon-inner preview">
              <view class="p-line p-line1"></view>
              <view class="p-line p-line2"></view>
              <view class="p-line p-line3"></view>
            </view>
          </view>
          
          <!-- 删除按钮 -->
          <view class="delete-icon" catchtap="deleteAnalysis" data-id="{{item.id}}">
            <view class="icon-inner">
              <view class="line line1"></view>
              <view class="line line2"></view>
            </view>
          </view>
        </view>
      </view>
    </view>
    
    <!-- 加载更多提示 -->
    <view class="load-more" wx:if="{{hasMore && !loading}}">
      <view class="load-more-text" bindtap="loadMore">加载更多</view>
    </view>
    <view class="load-more" wx:if="{{!hasMore && analysisList.length > 0}}">
      <view class="load-more-text">已经到底啦</view>
    </view>
    <view class="load-more loading" wx:if="{{loading}}">
      <view class="loading-icon"></view>
      <view class="load-more-text">加载中...</view>
    </view>
  </scroll-view>
  
  <!-- 空状态展示 -->
  <view class="empty-state" wx:if="{{!loading && analysisList.length === 0}}">
    <view class="empty-icon"></view>
    <view class="empty-text">暂无分析记录</view>
    <view class="empty-action" bindtap="navigateToUpload">去上传BP</view>
  </view>
  
  <!-- 首次加载中 -->
  <view class="loading-state" wx:if="{{loading && analysisList.length === 0}}">
    <view class="loading-icon"></view>
    <view class="loading-text">加载中...</view>
  </view>
</view>