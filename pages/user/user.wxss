/* pages/user/user.wxss */

.container {
  padding: 30rpx;
  background-color: #f7f8fa;
  min-height: 100vh;
}

/* 用户信息卡片 */
.user-card {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.user-info {
  display: flex;
  align-items: center;
  min-height: 120rpx;
}

/* 未登录状态 */
.not-login {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  padding: 40rpx 0;
}

.default-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-bottom: 20rpx;
}

.login-tip {
  font-size: 28rpx;
  color: var(--text-tertiary);
}

/* 登录按钮 */
.login-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #3370ff;
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
  border: none;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.avatar-wrapper {
  width: 120rpx;
  height: 120rpx;
  padding: 0;
  margin: 0;
  background: none;
  border: none;
  line-height: 1;
}

.avatar-wrapper::after {
  border: none;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 2rpx solid #f0f0f0;
}

.user-detail {
  flex: 1;
  margin-left: 30rpx;
}

.nickname-input {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  padding: 0;
  border: none;
  background: none;
}

.user-id {
  font-size: 24rpx;
  color: var(--text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 360rpx;
}

/* 功能列表 */
.menu-list {
  background-color: #fff;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.menu-arrow {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.5;
}

/* 退出按钮 */
.action-btn-wrap {
  padding: 30rpx;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #fff;
  color: #3370ff;
  font-size: 32rpx;
  border-radius: 44rpx;
  border: 1rpx solid #3370ff;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

/* 版本信息 */
.version-info {
  text-align: center;
  padding: 30rpx;
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* 数据统计 */
.stats-container {
  width: 100%;
  display: flex;
  background-color: #fff;
  margin-bottom: 20rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
  position: relative;
}

.stat-item:not(:last-child)::after {
  content: '';
  position: absolute;
  top: 30%;
  right: 0;
  height: 40%;
  width: 1px;
  background-color: #E5E7EB;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 500;
  color: #1F2937;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 28rpx;
  color: #6B7280;
}

/* 最近上传 */
.recent-container {
  width: calc(100% - 40rpx);
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 30rpx;
  color: #1F2937;
}

.bp-list {
  width: 100%;
}

.loading, .empty-tip {
  text-align: center;
  color: #9CA3AF;
  padding: 40rpx 0;
  font-size: 28rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
}

.bp-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #E5E7EB;
}

.bp-item:last-child {
  border-bottom: none;
}

.bp-item-left {
  flex: 1;
  overflow: hidden;
}

.bp-name {
  font-size: 28rpx;
  color: #1F2937;
  margin-bottom: 8rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
  max-width: 360rpx;
}

.bp-time {
  font-size: 24rpx;
  color: #9CA3AF;
}

/* 修改后的状态标签和操作按钮样式 */
.bp-action {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
  min-width: 140rpx;
}

.status-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-bottom: 10rpx;
}

.action-btn {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 24rpx;
  line-height: 1.2;
  min-height: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  max-width: 140rpx;
  white-space: nowrap;
}

.view-btn {
  background-color: #3875FF;
  color: #fff;
}

.analyze-btn {
  background-color: #10B981;
  color: #fff;
}

.retry-btn {
  background-color: #F59E0B;
  color: #fff;
}

.disabled-btn {
  background-color: #E5E7EB;
  color: #9CA3AF;
}

/* 状态标签样式 */
.pending {
  background-color: #FEF3C7;
  color: #D97706;
}

.analyzing {
  background-color: #DBEAFE;
  color: #2563EB;
}

.completed {
  background-color: #D1FAE5;
  color: #059669;
}

.failed {
  background-color: #FEE2E2;
  color: #DC2626;
}

/* 设置列表 */
.settings-container {
  width: calc(100% - 40rpx);
  background-color: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.setting-group {
  width: 100%;
}

.setting-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  position: relative;
  background-color: #fff;
  border-bottom: 1rpx solid #E5E7EB;
}

.setting-item::after {
  border: none;
}

.contact-btn {
  width: 100% !important;
  text-align: left;
  border-radius: 0;
  margin: 0 !important;
  font-weight: normal;
}

.setting-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  /* 这里应该使用icon图标，这里用背景色代替 */
  background-color: #E5E7EB;
  border-radius: 50%;
}

.setting-text {
  flex: 1;
  font-size: 30rpx;
  color: #374151;
}

.setting-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 2rpx solid #9CA3AF;
  border-right: 2rpx solid #9CA3AF;
  transform: rotate(45deg);
}

/* 开发环境下的重置按钮 */
.reset-btn-wrap {
  padding: 20rpx 30rpx;
}

.reset-btn {
  width: 100%;
  background-color: #fff;
  border: 1rpx solid #FF6B00;
  color: #FF6B00;
  border-radius: 8rpx;
  font-size: 32rpx;
  padding: 16rpx 0;
}

/* 开发图标 */
.icon-dev {
  background-color: #FF6B00 !important;
} 