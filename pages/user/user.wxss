/* pages/user/user.wxss */

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 0 40rpx 0;
  background-color: #f6f8fa;
  min-height: 100vh;
}

/* 用户信息卡片 */
.user-card {
  width: 100%;
  background-color: #3875FF;
  color: #fff;
  padding: 40rpx 30rpx;
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background-color: #fff;
  margin-right: 30rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: 500;
  margin-bottom: 10rpx;
}

.user-id {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.dev-tag {
  margin-top: 10rpx;
  background-color: rgba(255, 255, 255, 0.3);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  display: inline-block;
}

.login-btn {
  background-color: rgba(255, 255, 255, 0.9);
  color: #3875FF;
  font-size: 28rpx;
  padding: 12rpx 40rpx;
  border-radius: 40rpx;
  border: none;
  line-height: 1.5;
}

/* 数据统计 */
.stats-container {
  width: 100%;
  display: flex;
  background-color: #fff;
  margin-bottom: 20rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
  position: relative;
}

.stat-item:not(:last-child)::after {
  content: '';
  position: absolute;
  top: 30%;
  right: 0;
  height: 40%;
  width: 1px;
  background-color: #E5E7EB;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 500;
  color: #1F2937;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 28rpx;
  color: #6B7280;
}

/* 最近上传 */
.recent-container {
  width: calc(100% - 40rpx);
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 30rpx;
  color: #1F2937;
}

.bp-list {
  width: 100%;
}

.loading, .empty-tip {
  text-align: center;
  color: #9CA3AF;
  padding: 40rpx 0;
  font-size: 28rpx;
}

.bp-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #E5E7EB;
}

.bp-item:last-child {
  border-bottom: none;
}

.bp-item-left {
  flex: 1;
  overflow: hidden;
}

.bp-name {
  font-size: 28rpx;
  color: #1F2937;
  margin-bottom: 8rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
  max-width: 500rpx;
}

.bp-time {
  font-size: 24rpx;
  color: #9CA3AF;
}

.bp-status text {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.bp-status .pending {
  background-color: #FEF3C7;
  color: #D97706;
}

.bp-status .analyzing {
  background-color: #DBEAFE;
  color: #2563EB;
}

.bp-status .completed {
  background-color: #D1FAE5;
  color: #059669;
}

.bp-status .failed {
  background-color: #FEE2E2;
  color: #DC2626;
}

/* 设置列表 */
.settings-container {
  width: calc(100% - 40rpx);
  background-color: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.setting-group {
  width: 100%;
}

.setting-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  position: relative;
  background-color: #fff;
  border-bottom: 1rpx solid #E5E7EB;
}

.setting-item::after {
  border: none;
}

.contact-btn {
  width: 100% !important;
  text-align: left;
  border-radius: 0;
  margin: 0 !important;
  font-weight: normal;
}

.setting-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  /* 这里应该使用icon图标，这里用背景色代替 */
  background-color: #E5E7EB;
  border-radius: 50%;
}

.setting-text {
  flex: 1;
  font-size: 30rpx;
  color: #374151;
}

.setting-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 2rpx solid #9CA3AF;
  border-right: 2rpx solid #9CA3AF;
  transform: rotate(45deg);
}

/* 退出登录按钮 */
.logout-btn-wrap {
  padding: 40rpx 30rpx;
}

.logout-btn {
  width: 100%;
  background-color: #fff;
  border: 1rpx solid #EF4444;
  color: #EF4444;
  border-radius: 8rpx;
  font-size: 32rpx;
  padding: 16rpx 0;
}

/* 版本信息 */
.version-info {
  text-align: center;
  font-size: 24rpx;
  color: #9CA3AF;
  padding: 30rpx 0;
}

/* 开发环境下的重置按钮 */
.reset-btn-wrap {
  padding: 20rpx 30rpx;
}

.reset-btn {
  width: 100%;
  background-color: #fff;
  border: 1rpx solid #FF6B00;
  color: #FF6B00;
  border-radius: 8rpx;
  font-size: 32rpx;
  padding: 16rpx 0;
}

/* 开发图标 */
.icon-dev {
  background-color: #FF6B00 !important;
} 