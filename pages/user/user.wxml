<view class="container">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="user-info">
      <block wx:if="{{userInfo}}">
        <button class="avatar-wrapper" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
          <image class="avatar" src="{{userInfo.avatarUrl || defaultAvatarUrl}}"></image>
        </button>
        <view class="user-detail">
          <input type="nickname" class="nickname-input" placeholder="请输入昵称" bindblur="onNicknameBlur" value="{{userInfo.nickname}}"/>
          <view class="user-id">ID: {{userInfo.openid || '未登录'}}</view>
        </view>
      </block>
      <block wx:else>
        <button class="login-btn" bindtap="handleLogin">登录</button>
      </block>
    </view>
  </view>

  <!-- 上传历史列表 -->
  <view class="upload-history" wx:if="{{userInfo && uploadHistory.length > 0}}">
    <view class="section-header">
      <view class="section-title">我的上传</view>
      <view class="section-count">{{uploadHistory.length}} 个文件</view>
    </view>
    <view class="file-list">
      <view class="file-item" wx:for="{{uploadHistory}}" wx:key="id" data-type="{{item.fileType}}" hover-class="file-item-hover" hover-stay-time="100">
        <view class="file-info">
          <image class="file-icon" src="/assets/images/file-icons/file-{{item.fileType || 'unknown'}}.png" mode="aspectFit"></image>
          <view class="file-detail">
            <view class="file-name" title="{{item.fileName}}">{{item.fileName}}</view>
            <view class="file-meta">
              <text class="file-size">{{item.fileSize}}</text>
              <text class="meta-separator">·</text>
              <text class="file-time">{{item.uploadTime}}</text>
            </view>
          </view>
        </view>
        <view class="file-actions">
          <view class="icon-btn" hover-class="{{item.previewing ? '' : 'icon-btn-hover'}}" bindtap="{{item.previewing ? '' : 'previewFile'}}" data-id="{{item.id}}">
            <block wx:if="{{item.previewing}}">
              <view class="icon-loading"></view>
            </block>
            <block wx:else>
              <text class="icon-emoji">👁️</text>
            </block>
          </view>
          <view class="icon-btn {{item.hasAnalysis ? 'has-analysis' : ''}}" hover-class="{{item.analyzing ? '' : 'icon-btn-hover'}}" bindtap="{{item.analyzing ? '' : 'goToAnalysis'}}" data-id="{{item.id}}">
            <block wx:if="{{item.analyzing}}">
              <view class="icon-loading"></view>
            </block>
            <block wx:else>
              <image wx:if="{{item.hasAnalysis}}" class="icon-img" src="/assets/images/features/report.png" mode="aspectFit"></image>
              <image wx:else class="icon-img" src="/assets/images/analyze/analyze-icon.png" mode="aspectFit"></image>
            </block>
          </view>
          <view class="icon-btn {{!item.hasAnalysis ? 'disabled' : ''}}" hover-class="{{!item.hasAnalysis ? '' : 'icon-btn-hover'}}" bindtap="{{!item.hasAnalysis ? '' : 'reAnalyzeFile'}}" data-id="{{item.id}}">
            <image class="icon-img {{!item.hasAnalysis ? 'disabled-img' : ''}}" src="/assets/images/refresh.png" mode="aspectFit"></image>
          </view>
        </view>
      </view>
    </view>
    
    <!-- 加载更多按钮 -->
    <view class="load-more" wx:if="{{hasMore}}" bindtap="loadMoreFiles">
      <text wx:if="{{!loading}}">加载更多</text>
      <text wx:else>加载中...</text>
    </view>
    
    <!-- 无更多数据提示 -->
    <view class="no-more" wx:if="{{!hasMore && uploadHistory.length > 0}}">
      <text>— 没有更多数据 —</text>
    </view>
  </view>
  
  <!-- 空状态提示 -->
  <view class="empty-state" wx:if="{{userInfo && uploadHistory.length === 0 && !loading}}">
    <image class="empty-icon" src="/assets/images/empty-files.png"></image>
    <view class="empty-text">您还没有上传文件</view>
    <button class="upload-btn" bindtap="navigateToUpload">去上传</button>
  </view>

  <!-- 功能列表 -->
  <view class="menu-list">
    <view class="menu-item" bindtap="handleViewHistory">
      <image class="menu-icon" src="/assets/images/menu/history.png"></image>
      <view class="menu-text">分析历史</view>
      <image class="menu-arrow" src="/assets/images/arrow-right.png"></image>
    </view>
    <view class="menu-item" bindtap="handleViewFavorites">
      <image class="menu-icon" src="/assets/images/menu/favorite.png"></image>
      <view class="menu-text">收藏报告</view>
      <image class="menu-arrow" src="/assets/images/arrow-right.png"></image>
    </view>
    <view class="menu-item" bindtap="handleViewSettings">
      <image class="menu-icon" src="/assets/images/menu/settings.png"></image>
      <view class="menu-text">设置</view>
      <image class="menu-arrow" src="/assets/images/arrow-right.png"></image>
    </view>
  </view>

  <!-- 退出按钮 -->
  <view class="action-btn-wrap" wx:if="{{userInfo}}">
    <button class="logout-btn" bindtap="handleLogout">退出登录</button>
  </view>

  <!-- 版本信息 -->
  <view class="version-info">
    <text>版本 {{version}}</text>
  </view>
  
  <!-- Toast组件 -->
  <toast id="toast"></toast>
</view> 