.title {
  font-size: 18px;
  font-weight: bold;
  text-align: center;
  margin: 30rpx 0;
}

.test-section {
  margin: 40rpx 0;
  padding: 30rpx;
  background-color: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.subtitle {
  font-size: 16px;
  margin-bottom: 20rpx;
  color: #333;
}

.test-image {
  width: 240rpx;
  height: 240rpx;
  margin: 0 auto;
  display: block;
  background-color: #f5f5f5;
  border: 1px dashed #ccc;
}

.image-container {
  width: 240rpx;
  height: 240rpx;
  margin: 0 auto;
  background-color: #e0e0ff;
  border: 1px solid #9999cc;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-container .test-image {
  margin: 0;
  border: none;
  background: none;
  width: 100%;
  height: 100%;
} 