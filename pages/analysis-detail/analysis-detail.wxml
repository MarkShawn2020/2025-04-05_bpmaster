<view class="container">
  <!-- 顶部区域 -->
  <view class="header">
    <view class="back-btn" bind:tap="navigateBack">
      <text class="back-icon">←</text>
      <text>返回</text>
    </view>
    <view class="title-area">
      <view class="title">分析报告</view>
      <view class="subtitle" wx:if="{{fileInfo}}">{{fileInfo.name}}</view>
    </view>
    <view class="actions">
      <view class="action-btn" bind:tap="handleDownloadReport">
        <text class="icon">↓</text>
        <text>下载</text>
      </view>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <view class="loading-text">分析结果加载中...</view>
  </view>

  <!-- 错误提示 -->
  <view class="error-container" wx:elif="{{error}}">
    <view class="error-icon">!</view>
    <view class="error-text">{{error}}</view>
    <view class="error-action" bind:tap="navigateBack">返回上一页</view>
  </view>

  <!-- 内容区域 -->
  <view class="content-container" wx:elif="{{contentLoaded}}">
    <!-- Markdown内容 -->
    <view class="markdown-wrapper" wx:if="{{markdownContent}}">
      <markdown content="{{markdownContent}}" useCustomStyle="{{true}}"></markdown>
    </view>

    <!-- 无内容提示 -->
    <view class="empty-container" wx:else>
      <view class="empty-icon">📃</view>
      <view class="empty-text">暂无分析结果</view>
    </view>
  </view>

  <!-- Toast提示 -->
  <toast id="toast"></toast>
</view> 