<view class="container">
  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <view class="loading-text">分析结果加载中...</view>
  </view>
  
  <!-- 错误状态 -->
  <view class="error-container" wx:elif="{{error}}">
    <view class="error-icon">!</view>
    <view class="error-text">{{error}}</view>
    <view class="error-action" bindtap="goBack">返回上一页</view>
  </view>
  
  <!-- 内容区域 -->
  <block wx:else>
    <!-- 顶部区域 -->
    <view class="header">
      <view class="back-btn" bindtap="goBack">
        <text class="back-icon">←</text>
        <text>返回</text>
      </view>
      <view class="title-area">
        <view class="title">分析报告</view>
        <view class="subtitle" wx:if="{{analysisData}}">{{analysisData.fileName}}</view>
      </view>
      <view class="actions">
        <view class="action-btn" bindtap="exportReport">
          <text class="icon">↓</text>
          <text>导出</text>
        </view>
      </view>
    </view>
    
    <!-- 选项卡导航 -->
    <view class="tabs">
      <view 
        wx:for="{{tabs}}" 
        wx:key="id"
        class="tab {{activeTab === item.id ? 'active' : ''}}"
        bindtap="switchTab"
        data-id="{{item.id}}"
      >
        {{item.name}}
      </view>
    </view>
    
    <!-- 内容区域 -->
    <view class="tab-content">
      <!-- 概览标签 -->
      <view class="tab-pane" wx:if="{{activeTab === 'overview'}}">
        <view class="section-container">
          <view wx:for="{{sections.overview}}" wx:key="index" class="content-section">
            <view wx:if="{{item.type === 'heading1'}}" class="section-heading-1">{{item.title}}</view>
            <view wx:elif="{{item.type === 'heading2'}}" class="section-heading-2">{{item.title}}</view>
            <view wx:elif="{{item.type === 'heading3'}}" class="section-heading-3">{{item.title}}</view>
            
            <view class="section-content">
              <block wx:for="{{item.content}}" wx:for-item="contentItem" wx:for-index="contentIndex" wx:key="contentIndex">
                <view wx:if="{{contentItem.type === 'paragraph'}}" class="content-paragraph">{{contentItem.text}}</view>
                <view wx:elif="{{contentItem.type === 'listItem'}}" class="content-list-item">• {{contentItem.text}}</view>
              </block>
            </view>
          </view>
        </view>
      </view>
      
      <!-- 商业分析标签 -->
      <view class="tab-pane" wx:elif="{{activeTab === 'business'}}">
        <view class="section-container">
          <view wx:for="{{sections.business}}" wx:key="index" class="content-section">
            <view wx:if="{{item.type === 'heading1'}}" class="section-heading-1">{{item.title}}</view>
            <view wx:elif="{{item.type === 'heading2'}}" class="section-heading-2">{{item.title}}</view>
            <view wx:elif="{{item.type === 'heading3'}}" class="section-heading-3">{{item.title}}</view>
            
            <view class="section-content">
              <block wx:for="{{item.content}}" wx:for-item="contentItem" wx:for-index="contentIndex" wx:key="contentIndex">
                <view wx:if="{{contentItem.type === 'paragraph'}}" class="content-paragraph">{{contentItem.text}}</view>
                <view wx:elif="{{contentItem.type === 'listItem'}}" class="content-list-item">• {{contentItem.text}}</view>
              </block>
            </view>
          </view>
        </view>
      </view>
      
      <!-- 市场分析标签 -->
      <view class="tab-pane" wx:elif="{{activeTab === 'market'}}">
        <view class="section-container">
          <view wx:for="{{sections.market}}" wx:key="index" class="content-section">
            <view wx:if="{{item.type === 'heading1'}}" class="section-heading-1">{{item.title}}</view>
            <view wx:elif="{{item.type === 'heading2'}}" class="section-heading-2">{{item.title}}</view>
            <view wx:elif="{{item.type === 'heading3'}}" class="section-heading-3">{{item.title}}</view>
            
            <view class="section-content">
              <block wx:for="{{item.content}}" wx:for-item="contentItem" wx:for-index="contentIndex" wx:key="contentIndex">
                <view wx:if="{{contentItem.type === 'paragraph'}}" class="content-paragraph">{{contentItem.text}}</view>
                <view wx:elif="{{contentItem.type === 'listItem'}}" class="content-list-item">• {{contentItem.text}}</view>
              </block>
            </view>
          </view>
        </view>
      </view>
      
      <!-- 团队评估标签 -->
      <view class="tab-pane" wx:elif="{{activeTab === 'team'}}">
        <view class="section-container">
          <view wx:for="{{sections.team}}" wx:key="index" class="content-section">
            <view wx:if="{{item.type === 'heading1'}}" class="section-heading-1">{{item.title}}</view>
            <view wx:elif="{{item.type === 'heading2'}}" class="section-heading-2">{{item.title}}</view>
            <view wx:elif="{{item.type === 'heading3'}}" class="section-heading-3">{{item.title}}</view>
            
            <view class="section-content">
              <block wx:for="{{item.content}}" wx:for-item="contentItem" wx:for-index="contentIndex" wx:key="contentIndex">
                <view wx:if="{{contentItem.type === 'paragraph'}}" class="content-paragraph">{{contentItem.text}}</view>
                <view wx:elif="{{contentItem.type === 'listItem'}}" class="content-list-item">• {{contentItem.text}}</view>
              </block>
            </view>
          </view>
        </view>
      </view>
      
      <!-- 财务分析标签 -->
      <view class="tab-pane" wx:elif="{{activeTab === 'financial'}}">
        <view class="section-container">
          <view wx:for="{{sections.financial}}" wx:key="index" class="content-section">
            <view wx:if="{{item.type === 'heading1'}}" class="section-heading-1">{{item.title}}</view>
            <view wx:elif="{{item.type === 'heading2'}}" class="section-heading-2">{{item.title}}</view>
            <view wx:elif="{{item.type === 'heading3'}}" class="section-heading-3">{{item.title}}</view>
            
            <view class="section-content">
              <block wx:for="{{item.content}}" wx:for-item="contentItem" wx:for-index="contentIndex" wx:key="contentIndex">
                <view wx:if="{{contentItem.type === 'paragraph'}}" class="content-paragraph">{{contentItem.text}}</view>
                <view wx:elif="{{contentItem.type === 'listItem'}}" class="content-list-item">• {{contentItem.text}}</view>
              </block>
            </view>
          </view>
        </view>
      </view>
    </view>
    
    <!-- 流式模式提示 -->
    <view class="stream-status" wx:if="{{isStreamMode && !loading}}">
      <view class="stream-status-text" wx:if="{{markdownContent && markdownContent.length > 0}}">
        实时分析中，内容将自动更新...
      </view>
      <view class="stream-status-text" wx:else>
        正在等待分析结果...
      </view>
    </view>
    
    <!-- 底部工具栏 -->
    <view class="action-bar">
      <button class="btn-secondary" bindtap="goBack">返回</button>
      <button class="btn-share" open-type="share">分享</button>
    </view>
  </block>
  
  <!-- Toast组件 -->
  <mp-toast id="toast"></mp-toast>
</view> 