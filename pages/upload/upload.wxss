/* pages/upload/upload.wxss */

.container {
  padding: 30rpx;
  min-height: 100vh;
  background-color: #f8f9fa;
}

.upload-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 30rpx;
}

.card-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.card-subtitle {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 40rpx;
}

/* 上传区域 */
.upload-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 360rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  background-color: #f9fafc;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.upload-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 30rpx;
}

.upload-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 16rpx;
}

.upload-hint {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 10rpx;
  text-align: center;
}

.upload-tip {
  font-size: 22rpx;
  color: #999;
  margin-top: 20rpx;
}

/* 文件列表区域 */
.file-list-area {
  padding: 20rpx 0;
}

.file-list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.file-count {
  font-size: 28rpx;
  color: #666;
}

.file-actions-header {
  display: flex;
  align-items: center;
}

.btn-text {
  background: none;
  border: none;
  color: #2b85e4;
  font-size: 28rpx;
  padding: 0;
  line-height: normal;
  margin: 0;
}

.btn-text::after {
  border: none;
}

.file-list {
  max-height: 600rpx;
  overflow-y: auto;
}

.file-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1px solid #f0f0f0;
}

.file-select {
  margin-right: 20rpx;
}

.file-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.file-icon {
  width: 70rpx;
  height: 70rpx;
  margin-right: 20rpx;
}

.file-detail {
  flex: 1;
}

.file-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 6rpx;
  word-break: break-all;
}

.file-meta {
  font-size: 24rpx;
  color: #999;
}

.file-actions {
  display: flex;
  align-items: center;
}

.delete-btn {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 40rpx;
  font-weight: 300;
}

.file-list-footer {
  display: flex;
  justify-content: space-between;
  margin-top: 40rpx;
}

/* 上传进度区域 */
.progress-area {
  padding: 30rpx 0;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.progress-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.progress-percent {
  font-size: 30rpx;
  color: #2b85e4;
  font-weight: 500;
}

.progress-bar-bg {
  height: 20rpx;
  background-color: #f0f0f0;
  border-radius: 10rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.progress-bar {
  height: 100%;
  background-color: #2b85e4;
  border-radius: 10rpx;
  transition: width 0.3s ease;
}

.progress-bar-analysis {
  background-color: #f5a623;
}

.file-icon-sm {
  width: 36rpx;
  height: 36rpx;
  margin-right: 10rpx;
}

.file-name-sm {
  font-size: 24rpx;
  color: #666;
  max-width: 440rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 分析阶段信息 */
.analysis-info {
  margin-top: 20rpx;
}

.analysis-stage {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.analysis-hint {
  font-size: 24rpx;
  color: #888;
}

/* 上传成功区域 */
.success-area {
  padding: 40rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.success-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 30rpx;
}

.success-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 20rpx;
}

/* 错误卡片 */
.error-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 30rpx;
  border-left: 8rpx solid #f56c6c;
}

.error-title {
  font-size: 32rpx;
  color: #f56c6c;
  font-weight: 500;
  margin-bottom: 20rpx;
}

.error-message {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 30rpx;
}

/* 信息卡片 */
.info-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.info-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 30rpx;
}

.format-list {
  display: flex;
  justify-content: space-around;
  margin-bottom: 30rpx;
}

.format-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.format-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 16rpx;
}

.format-name {
  font-size: 24rpx;
  color: #666;
}

.format-note {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}

.format-note-text {
  font-size: 24rpx;
  color: #999;
}

/* 按钮样式 */
.btn-primary {
  background-color: #2b85e4;
  color: #fff;
  font-size: 28rpx;
  padding: 0 30rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 8rpx;
}

.btn-secondary {
  background-color: #f7f7f7;
  color: #666;
  font-size: 28rpx;
  padding: 0 30rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 8rpx;
  border: 1rpx solid #ddd;
}

.btn-sm {
  height: 70rpx;
  line-height: 70rpx;
  font-size: 26rpx;
  padding: 0 20rpx;
}

/* 分析结果展示 */
.analysis-result-container {
  margin-top: 20rpx;
}

.analysis-result-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 30rpx;
}

.analysis-result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.analysis-result-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.analysis-result-score {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.score-value {
  font-size: 48rpx;
  font-weight: 600;
  color: #2b85e4;
}

.score-label {
  font-size: 24rpx;
  color: #666;
}

.analysis-section {
  margin-bottom: 40rpx;
}

.analysis-section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 20rpx;
  border-left: 8rpx solid #2b85e4;
}

.markdown-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.analysis-detail-item {
  margin-bottom: 30rpx;
  padding: 20rpx;
  background-color: #f9fafc;
  border-radius: 8rpx;
}

.analysis-detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #eee;
}

.analysis-detail-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.analysis-detail-score {
  font-size: 36rpx;
  font-weight: 600;
  color: #666;
  min-width: 60rpx;
  text-align: center;
}

.score-excellent {
  color: #67c23a;
}

.score-good {
  color: #409eff;
}

.score-average {
  color: #f56c6c;
}

.analysis-detail-content {
  padding: 0 10rpx;
}

.analysis-detail-section {
  margin-bottom: 20rpx;
}

.analysis-detail-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #555;
  margin-bottom: 10rpx;
}

.analysis-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 40rpx;
  padding-top: 30rpx;
  border-top: 2rpx solid #f0f0f0;
} 