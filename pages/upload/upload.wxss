/* pages/upload/upload.wxss */

.container {
  padding: 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background-color: #f5f7fa;
}

.upload-card {
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  padding: 40rpx;
  margin-bottom: 30rpx;
}

.card-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.card-subtitle {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 40rpx;
}

/* 上传区域 */
.upload-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 400rpx;
  border: 2rpx dashed #bdc6d8;
  border-radius: 12rpx;
  background-color: #f9fafc;
  padding: 40rpx;
  margin: 30rpx 0;
  cursor: pointer;
}

.upload-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
}

.upload-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 16rpx;
}

.upload-hint {
  font-size: 28rpx;
  color: #999;
  text-align: center;
  max-width: 500rpx;
  margin-bottom: 10rpx;
}

/* 文件列表区域 */
.file-list-area {
  margin: 30rpx 0;
}

.file-list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.file-count {
  font-size: 28rpx;
  color: #666;
}

.file-actions-header {
  display: flex;
  align-items: center;
}

.btn-text {
  background: none;
  border: none;
  font-size: 28rpx;
  color: #1890ff;
  padding: 0;
  line-height: 1;
  margin: 0;
}

.btn-text::after {
  border: none;
}

.file-list {
  margin-bottom: 30rpx;
  max-height: 600rpx;
  overflow-y: auto;
}

.file-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #eee;
  background-color: #fff;
}

.file-select {
  margin-right: 20rpx;
}

.file-info {
  flex: 1;
  display: flex;
  align-items: center;
  overflow: hidden;
}

.file-icon {
  width: 60rpx;
  height: 60rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.file-detail {
  flex: 1;
  overflow: hidden;
}

.file-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 440rpx;
}

.file-meta {
  font-size: 24rpx;
  color: #999;
}

.file-actions {
  display: flex;
  align-items: center;
}

.delete-btn {
  color: #999;
  font-size: 40rpx;
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.file-list-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 30rpx;
}

/* 上传进度区域 */
.progress-area {
  margin: 30rpx 0;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.progress-percent {
  font-size: 30rpx;
  color: #1890ff;
  font-weight: 500;
}

.progress-bar-bg {
  height: 16rpx;
  background-color: #f0f2f5;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.progress-bar {
  height: 100%;
  background-color: #1890ff;
  border-radius: 8rpx;
  transition: width 0.3s;
}

.progress-bar-analysis {
  background-color: #52c41a;
}

.progress-info {
  display: flex;
  align-items: center;
  margin-top: 30rpx;
}

.loading-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
  animation: rotate 1.5s linear infinite;
}

.progress-text {
  font-size: 28rpx;
  color: #666;
}

/* 上传成功区域 */
.success-area {
  margin: 30rpx 0;
}

.success-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.success-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 20rpx;
}

.success-info {
  flex: 1;
}

.success-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #52c41a;
  margin-bottom: 8rpx;
}

.success-count {
  font-size: 28rpx;
  color: #666;
}

.success-file-list {
  background-color: #f9fafc;
  border-radius: 8rpx;
  margin: 20rpx 0 30rpx;
  padding: 10rpx;
  max-height: 400rpx;
  overflow-y: auto;
}

.success-file-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #eee;
  background-color: #fff;
  border-radius: 8rpx;
  margin-bottom: 10rpx;
}

.success-file-item:last-child {
  margin-bottom: 0;
  border-bottom: none;
}

.file-status {
  margin-left: auto;
}

.file-status-badge {
  background-color: #e6f7ff;
  color: #1890ff;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.action-buttons {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
}

/* 分析状态样式 */
.analysis-progress {
  margin: 30rpx 0;
}

.analysis-info {
  display: flex;
  align-items: center;
  margin-top: 30rpx;
}

.analysis-detail {
  flex: 1;
}

.analysis-stage {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.analysis-hint {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 错误卡片 */
.error-card {
  background-color: #fff1f0;
  border: 1px solid #ffa39e;
  padding: 30rpx;
  border-radius: 16rpx;
  margin: 30rpx 0;
}

.error-title {
  font-size: 32rpx;
  color: #f5222d;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.error-message {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

/* 信息卡片 */
.info-card {
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  padding: 40rpx;
}

.info-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 30rpx;
}

.format-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.format-item {
  width: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}

.format-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 16rpx;
}

.format-name {
  font-size: 26rpx;
  color: #666;
}

.format-note {
  padding: 20rpx;
  background-color: #f9fafc;
  border-radius: 8rpx;
}

.format-note-text {
  font-size: 26rpx;
  color: #999;
  line-height: 1.5;
}

/* 按钮样式 */
.btn-primary {
  background-color: #1890ff;
  color: #fff;
  border: none;
  border-radius: 8rpx;
  font-size: 28rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background-color: #f5f7fa;
  color: #666;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 28rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.btn-secondary::after {
  border: none;
}

/* 动画 */
@keyframes rotate {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
} 