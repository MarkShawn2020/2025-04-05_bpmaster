<view class="container">
  <!-- 选择文件卡片 -->
  <view class="upload-card">
    <view class="card-title">上传商业计划书</view>
    <view class="card-subtitle">上传你的商业计划书，获取专业AI评估</view>
    
    <!-- 未选择文件时 -->
    <view class="upload-area" bindtap="handleChooseFile" wx:if="{{!file.name}}">
      <image class="upload-icon" src="/images/upload-icon.png"></image>
      <view class="upload-text">点击选择文件</view>
      <view class="upload-hint">支持PDF、Word、PPT等格式，文件大小不超过20MB</view>
    </view>
    
    <!-- 已选择文件但未上传时 -->
    <view class="file-info-area" wx:if="{{file.name && step === 'choose'}}">
      <view class="file-info">
        <image class="file-icon" src="{{file.type ? '/images/file-icons/file-' + file.type + '.png' : '/images/file-icons/file-unknown.png'}}"></image>
        <view class="file-detail">
          <view class="file-name">{{file.name || '未知文件'}}</view>
          <view class="file-meta">{{file.sizeText || ''}} · {{file.time || ''}}</view>
        </view>
      </view>
      <view class="file-actions">
        <button class="btn-sm" type="default" bindtap="handleChooseFile">重新选择</button>
        <button class="btn-sm" type="primary" bindtap="handleUploadFile">开始上传</button>
      </view>
    </view>
    
    <!-- 上传中 -->
    <view class="progress-area" wx:if="{{step === 'uploading'}}">
      <view class="progress-header">
        <view class="progress-title">上传中...</view>
        <view class="progress-percent">{{uploadProgress}}%</view>
      </view>
      <view class="progress-bar-bg">
        <view class="progress-bar" style="width: {{uploadProgress}}%;"></view>
      </view>
      <view class="file-info">
        <image class="file-icon-sm" src="{{file.type ? '/images/file-icons/file-' + file.type + '.png' : '/images/file-icons/file-unknown.png'}}"></image>
        <view class="file-name-sm">{{file.name || '未知文件'}}</view>
      </view>
    </view>
    
    <!-- 上传成功 -->
    <view class="success-area" wx:if="{{step === 'success'}}">
      <view class="success-header">
        <image class="success-icon" src="/images/check-circle.png"></image>
        <view class="success-text">上传成功</view>
      </view>
      <view class="file-info">
        <image class="file-icon-sm" src="{{file.type ? '/images/file-icons/file-' + file.type + '.png' : '/images/file-icons/file-unknown.png'}}"></image>
        <view class="file-detail">
          <view class="file-name">{{file.name || '未知文件'}}</view>
          <view class="file-meta">{{file.sizeText || ''}} · {{file.time || ''}}</view>
        </view>
      </view>
      <view class="analysis-actions">
        <button class="btn-secondary" type="default" bindtap="handleReset">重新上传</button>
        <button class="btn-primary" type="primary" bindtap="handleStartAnalysis">
          <text>开始分析</text>
        </button>
      </view>
    </view>
    
    <!-- 上传失败 -->
    <view class="error-card" wx:if="{{step === 'error'}}">
      <view class="error-title">上传失败</view>
      <view class="error-message">{{errorMessage || '文件上传失败，请重试'}}</view>
      <button type="primary" bindtap="handleReset">重新上传</button>
    </view>
  </view>
  
  <!-- 文件格式说明卡片 -->
  <view class="info-card">
    <view class="info-title">支持的文件格式</view>
    <view class="format-list">
      <view class="format-item">
        <image class="format-icon" src="/images/file-icons/file-pdf.png"></image>
        <view class="format-name">PDF</view>
      </view>
      <view class="format-item">
        <image class="format-icon" src="/images/file-icons/file-doc.png"></image>
        <view class="format-name">Word</view>
      </view>
      <view class="format-item">
        <image class="format-icon" src="/images/file-icons/file-ppt.png"></image>
        <view class="format-name">PPT</view>
      </view>
      <view class="format-item">
        <image class="format-icon" src="/images/file-icons/file-txt.png"></image>
        <view class="format-name">TXT</view>
      </view>
    </view>
    <view class="format-note">
      <view class="format-note-text">上传前请确保您的商业计划书内容完整、真实，以获得最准确的评估结果</view>
    </view>
  </view>
  
  <!-- AI分析能力卡片 -->
  <view class="info-card">
    <view class="info-title">AI分析能力</view>
    <view class="feature-list">
      <view class="feature-item-small">
        <image class="feature-icon-small" src="/images/features/summary.png"></image>
        <view class="feature-name">项目概述</view>
      </view>
      <view class="feature-item-small">
        <image class="feature-icon-small" src="/images/features/market.png"></image>
        <view class="feature-name">市场分析</view>
      </view>
      <view class="feature-item-small">
        <image class="feature-icon-small" src="/images/features/team.png"></image>
        <view class="feature-name">团队评估</view>
      </view>
      <view class="feature-item-small">
        <image class="feature-icon-small" src="/images/features/finance.png"></image>
        <view class="feature-name">财务评估</view>
      </view>
      <view class="feature-item-small">
        <image class="feature-icon-small" src="/images/features/model.png"></image>
        <view class="feature-name">商业模式</view>
      </view>
      <view class="feature-item-small">
        <image class="feature-icon-small" src="/images/features/risk.png"></image>
        <view class="feature-name">风险分析</view>
      </view>
    </view>
  </view>
  
  <!-- toast组件 -->
  <toast id="toast"></toast>
</view> 