{
  "openapi": "3.0.0",
  "info": {
    "title": "BP小诸葛 API",
    "description": "商业计划书AI分析小程序API接口文档",
    "version": "1.0.0",
    "contact": {
      "name": "开发团队"
    }
  },
  "servers": [
    {
      "url": "https://api.bpmaster.cn/v1",
      "description": "生产环境"
    },
    {
      "url": "https://dev-api.bpmaster.cn/v1",
      "description": "开发环境"
    }
  ],
  "tags": [
    {
      "name": "文件操作",
      "description": "文件上传和管理相关接口"
    },
    {
      "name": "AI分析",
      "description": "商业计划书AI分析相关接口"
    },
    {
      "name": "历史记录",
      "description": "分析历史记录相关接口"
    },
    {
      "name": "用户管理",
      "description": "用户信息和认证相关接口"
    }
  ],
  "paths": {
    "/file/upload": {
      "post": {
        "tags": ["文件操作"],
        "summary": "上传商业计划书文件",
        "description": "上传商业计划书文件到云存储，支持PDF、Word、PPT、TXT格式",
        "operationId": "uploadFile",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "要上传的文件"
                  },
                  "originalFileName": {
                    "type": "string",
                    "description": "原始文件名（可选）"
                  }
                },
                "required": ["file"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "文件上传成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadResponse"
                }
              }
            }
          },
          "400": {
            "description": "无效的请求参数",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "未授权",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "文件太大",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "不支持的文件类型",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "服务器错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/coze/workflow/stream_run": {
      "post": {
        "tags": ["AI分析"],
        "summary": "流式执行Coze工作流",
        "description": "使用流式响应方式执行已发布的Coze工作流，用于实时分析商业计划书并返回结果。支持打字机效果，适用于消息节点、问答节点和开启了流式输出的结束节点。",
        "operationId": "streamRunCozeWorkflow",
        "security": [
          {
            "CozeAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "workflow_id": {
                    "type": "string",
                    "description": "要执行的Coze工作流ID",
                    "example": "73664689170551*****"
                  },
                  "parameters": {
                    "type": "object",
                    "description": "工作流的输入参数",
                    "example": {
                      "files": ["https://storage.bpmaster.cn/files/temp/bp_files/1234567890_business_plan.pdf"]
                    }
                  },
                  "bot_id": {
                    "type": "string",
                    "description": "关联的智能体ID（可选）。部分工作流需要关联智能体，例如存在数据库节点、变量节点等。"
                  }
                },
                "required": ["workflow_id"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "工作流流式执行成功，以SSE(Server-Sent Events)格式返回",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "examples": {
                  "message-event": {
                    "value": "id: 0\nevent: Message\ndata: {\"content\":\"正在分析您的商业计划书...\",\"node_is_finish\":false,\"node_seq_id\":\"0\",\"node_title\":\"Message\"}\n\nid: 1\nevent: Message\ndata: {\"content\":\"为\",\"node_is_finish\":false,\"node_seq_id\":\"1\",\"node_title\":\"Message\"}\n\nid: 2\nevent: Done\ndata: {}\n"
                  }
                }
              }
            }
          },
          "400": {
            "description": "无效的请求参数",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CozeErrorResponse"
                },
                "example": {
                  "error_code": 4000,
                  "error_message": "请求参数错误"
                }
              }
            }
          },
          "401": {
            "description": "未授权",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CozeErrorResponse"
                },
                "example": {
                  "error_code": 4010,
                  "error_message": "Token无效或已过期"
                }
              }
            }
          },
          "403": {
            "description": "权限不足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CozeErrorResponse"
                },
                "example": {
                  "error_code": 4030,
                  "error_message": "权限不足，缺少run权限"
                }
              }
            }
          },
          "422": {
            "description": "工作流未发布",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CozeErrorResponse"
                },
                "example": {
                  "error_code": 4200,
                  "error_message": "工作流未发布"
                }
              }
            }
          },
          "500": {
            "description": "服务器错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CozeErrorResponse"
                },
                "example": {
                  "error_code": 5000,
                  "error_message": "服务器内部错误"
                }
              }
            }
          }
        }
      }
    },
    "/ai/analyze": {
      "post": {
        "tags": ["AI分析"],
        "summary": "开始商业计划书分析",
        "description": "使用Coze工作流对已上传的商业计划书进行AI分析",
        "operationId": "startAnalysis",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "fileId": {
                    "type": "string",
                    "description": "上传文件后获得的文件ID"
                  },
                  "fileName": {
                    "type": "string",
                    "description": "文件名称"
                  },
                  "fileUrl": {
                    "type": "string",
                    "description": "文件URL"
                  }
                },
                "required": ["fileId"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "分析任务已创建",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResponse"
                }
              }
            }
          },
          "400": {
            "description": "无效的请求参数",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "未授权",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "文件不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "服务器错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ai/stream": {
      "post": {
        "tags": ["AI分析"],
        "summary": "流式返回分析结果",
        "description": "通过流式响应返回Coze工作流的实时分析结果",
        "operationId": "streamAnalysisResult",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "fileId": {
                    "type": "string",
                    "description": "已上传文件的ID"
                  },
                  "sessionId": {
                    "type": "string",
                    "description": "分析会话ID"
                  },
                  "workflowId": {
                    "type": "string",
                    "description": "Coze工作流ID"
                  }
                },
                "required": ["fileId", "sessionId"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "流式分析结果",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "无效的请求参数",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "未授权",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "文件或会话不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "服务器错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ai/status/{fileId}": {
      "get": {
        "tags": ["AI分析"],
        "summary": "查询分析状态",
        "description": "查询特定文件的分析状态和结果",
        "operationId": "getAnalysisStatus",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "fileId",
            "in": "path",
            "description": "文件ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "分析状态和结果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisStatusResponse"
                }
              }
            }
          },
          "401": {
            "description": "未授权",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "文件或分析记录不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "服务器错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/history": {
