  "components": {
    "schemas": {
      "FileUploadResponse": {
        "type": "object",
        "properties": {
          "fileId": {
            "type": "string",
            "description": "上传文件的唯一标识",
            "example": "file_12345678"
          },
          "fileUrl": {
            "type": "string",
            "description": "文件的临时访问URL",
            "example": "https://storage.bpmaster.cn/files/temp/bp_files/1234567890_business_plan.pdf"
          }
        }
      },
      "AnalysisResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "sessionId": {
            "type": "string",
            "description": "分析会话ID，用于查询分析状态和结果",
            "example": "session_12345678"
          },
          "status": {
            "type": "string",
            "description": "分析任务状态",
            "enum": ["pending", "processing", "completed", "failed"],
            "example": "processing"
          }
        }
      },
      "AnalysisStatusResponse": {
        "type": "object",
        "properties": {
          "fileId": {
            "type": "string",
            "example": "file_12345678"
          },
          "fileName": {
            "type": "string",
            "example": "商业计划书.pdf"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "processing", "completed", "failed"],
            "example": "completed"
          },
          "progress": {
            "type": "number",
            "description": "分析进度（0-100）",
            "example": 100
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2023-04-01T12:00:00Z"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2023-04-01T12:02:30Z"
          },
          "content": {
            "type": "string",
            "description": "分析结果内容（Markdown格式）",
            "example": "# 商业计划书分析报告\n\n## 项目概述\n\n这是一个很有前景的项目..."
          }
